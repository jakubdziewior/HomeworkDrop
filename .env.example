APP_NAME=HomeworkDrop
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Baza danych: SQLite (dev) lub PostgreSQL, np. postgresql+psycopg://user:haslo@localhost:5432/homeworkdrop
DATABASE_URL=sqlite:///./homeworkdrop.db
DB_ECHO=false

# JWT – w produkcji ustaw losowy klucz, np.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=homeworkdrop-super-secure-production-secret-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=homeworkdrop-api
JWT_AUDIENCE=homeworkdrop-frontend

# Ciasteczko z tokenem (zawsze HttpOnly)
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict

# Wgrywanie plików (katalog poza kodem aplikacji, bez uprawnień do wykonywania)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
